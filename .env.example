# Prefer environment credentials; never put secrets in config.json or source code.
KFC_API_KEY=

# OpenAI-compatible provider settings. Protocol may also be openai-responses.
KFC_PROTOCOL=openai-chat-completions
KFC_BASE_URL=https://your-provider.example/v1
KFC_MODEL=your-model-name
KFC_TIMEOUT_MS=60000

# Optional override for the user configuration file location.
# KFC_CONFIG_PATH=./config.json

# Optional plaintext credentials-file override (created with mode 0600).
KFC_CREDENTIALS_PATH=
